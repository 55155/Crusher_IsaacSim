<launch>

<rosparam file="$(find Crusher_IsaacSim_description)/launch/controller.yaml" command="load"/>
<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="Crusher_IsaacSim" args="Revolute 27_position_controller Revolute 30_position_controller Revolute 31_position_controller Revolute 41_position_controller Revolute 44_position_controller Revolute 45_position_controller Slider 48_position_controller Slider 56_position_controller joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
  <remap from="/joint_states" to="/Crusher_IsaacSim/joint_states"/>
</node>

</launch>