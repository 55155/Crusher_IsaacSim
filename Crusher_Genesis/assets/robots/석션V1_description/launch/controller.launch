<launch>

<rosparam file="$(find 석션V1_description)/launch/controller.yaml" command="load"/>
<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="석션V1" args="슬라이더 2_position_controller 슬라이더 11_position_controller 슬라이더 12_position_controller joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
  <remap from="/joint_states" to="/석션V1/joint_states"/>
</node>

</launch>