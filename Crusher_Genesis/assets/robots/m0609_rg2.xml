<mujoco model="m0609_rg2">

  <compiler angle="degree"/>

  <asset>
    <mesh name="MF0609_0_0" file="m0609/assets/MF0609_0_0.stl" scale="0.001 0.001 0.001"/>
    <mesh name="MF0609_0_0_vis" file="m0609/assets/MF0609_0_0_ss.obj" scale="0.001 0.001 0.001"/>
    <mesh name="MF0609_1_0" file="m0609/assets/MF0609_1_0.stl" scale="0.001 0.001 0.001"/>
