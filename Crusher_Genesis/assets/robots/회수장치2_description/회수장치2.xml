       였으나, URDF 트리 구조가 다중 부모를 표현할 수 없어 링크가 2개로 쪼개져
       export됨. weld는 위치+방향을 전부 고정해 두 회전 자유도를 과도하게 묶어버리므로
       (평면 내 상대 회전이 막힘), 위치만 고정하고 상대 회전은 자유로 두는 connect 사용.

       anchor 유도(파일 내 정확값에서 대수적으로 계산, 근사 아님):
       각 인스턴스의 joint origin이 곧 그 인스턴스의 "가까운 쪽" 핀 위치이므로
       body origin = 그 핀 위치. 두 인스턴스 모두 동일 mesh(Crank_1.stl)를 회전 없이
       (quat="1 0 0 0") pos 오프셋만으로 배치했으므로, raw mesh 좌표계가 두 인스턴스
       에서 그대로 정렬됨. 따라서 "먼 쪽(반대편) 핀"의 위치, 즉 Crank_1_b 자기 좌표계
       기준 anchor = (Crank_1_b의 geom offset) - (Crank_1의 geom offset)
                    = (0.091515,-0.05922,-0.04088) - (0.031515,-0.05922,-0.04688)
                    = (0.06, 0.0, 0.006)
       -- Fusion에서 dump_joint_anchors로 직접 뽑은 실측 핀-핀 거리(0.060299m)와
       이 anchor의 크기(√(0.06²+0.006²)=0.060299m)가 정확히 일치해 검증됨. -->
  <equality>
    <connect name="crank_loop_close" body1="Crank_1_b" body2="Crank_1" anchor="0.06 0.0 0.006"/>
  </equality>

  <!-- base_link_Shaft_copy_1: base_link(F프레임 바닥)과 Shaft_copy_1(메인 샤프트) 사이의
       구동 조인트 -->
  <actuator>
    <motor name="base_link_Shaft_copy_1_motor" joint="base_link_Shaft_copy_1" ctrlrange="-100 100" ctrllimited="true"/>
  </actuator>
</mujoco>
