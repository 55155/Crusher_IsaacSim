<?xml version="1.0" ?>
<robot name="회수장치2" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<transmission name="회전 29_tran">
  <type>transmission_interface/SimpleTransmission</type>
  <joint name="회전 29">
