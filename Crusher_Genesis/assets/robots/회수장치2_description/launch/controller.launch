<launch>

<rosparam file="$(find 회수장치2_description)/launch/controller.yaml" command="load"/>
<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="회수장치2" args="회전 29_position_controller 회전 31_position_controller 회전 34_position_controller 슬라이더 35_position_controller joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
  <remap from="/joint_states" to="/회수장치2/joint_states"/>
</node>

</launch>