<?xml version="1.0" ?>
<robot name="고정장치" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<transmission name="Servo3_ServoShaft_tran">
  <type>transmission_interface/SimpleTransmission</type>
  <joint name="Servo3_ServoShaft">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
  </joint>
  <actuator name="Servo3_ServoShaft_actr">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    <mechanicalReduction>1</mechanicalReduction>
  </actuator>
</transmission>

</robot>
